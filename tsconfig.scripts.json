{
  // Typechecks scripts/ (and whatever they import, such as orchestrator/ and
  // config/) with the same strict settings as the src/ build. tsconfig.json
  // covers src/ only, so until this existed none of the CLI scripts were
  // typechecked. CI runs it; locally: npm run typecheck:scripts
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
