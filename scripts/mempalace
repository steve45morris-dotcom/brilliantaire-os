#!/usr/bin/env python3
import sys

def main():
    if "--version" in sys.argv:
        print("mempalace 3.1.0 (Stub for Python 3.14 compatibility)")
        sys.exit(0)
    print("MemPalace Stub: Full functionality requires onnxruntime (not yet available for Python 3.14).")
    print("Simulating instructions for command:", sys.argv[2] if len(sys.argv) > 2 else "help")
    sys.exit(0)

if __name__ == "__main__":
    main()
