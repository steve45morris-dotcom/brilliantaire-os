# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/supernova
SUPERNOVA_DB_PATH=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Logging ---
LOG_LEVEL=INFO
SERVICE_NAME=SUPERNOVA_CORE

# --- Feature Flags ---
STRICT_HEALTH_CHECK=true
ENABLE_WORKER=true

# --- OpenAI Integration ---
OPENAI_API_KEY=unconfigured
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_REASONING_MODEL=o3-mini
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_MONTHLY_BUDGET_LIMIT=50.0
OPENAI_DAILY_BUDGET_LIMIT=5.0
OPENAI_ENABLE_WEB_SEARCH=false
OPENAI_ENABLE_FILE_SEARCH=false
OPENAI_ENABLE_IMAGE_GENERATION=false
OPENAI_ENABLE_REALTIME=false
OPENAI_ENABLE_AGENTS_SDK=false
OPENAI_ENABLE_MCP=false

