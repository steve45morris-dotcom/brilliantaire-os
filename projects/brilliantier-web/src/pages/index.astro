    </section>

    <!-- METRICS SECTION -->
    <section class="py-24 bg-base-200">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
          <span class="text-primary font-mono text-xs uppercase tracking-widest mb-2 block">Live Telemetry</span>
          <h2 class="font-display font-black text-4xl sm:text-5xl text-white mb-4 tracking-tight">
            Mesh Ingest Preview
          </h2>
          <p class="text-gray-400 font-mono max-w-xl mx-auto text-sm sm:text-base">
            Live metric indices parsed across YouTube, TikTok, Instagram, Facebook, WhatsApp, and Obsidian.
          </p>
        </div>

        <MetricsPreview client:visible />
