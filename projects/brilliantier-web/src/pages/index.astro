---
import MetricsPreview from '../components/MetricsPreview';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" data-theme="brand" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Brilliantier OS - Phase 22: Post-Singularity Omnipresence Interface" />
    <title>Brilliantier OS</title>
  </head>
  <body class="bg-base-100 font-mono text-base-content overflow-x-hidden selection:bg-primary selection:text-white">

    <!-- HERO SECTION -->
    <header class="relative min-h-screen flex flex-col justify-between overflow-hidden">
      <!-- Pulse grid background -->
      <div class="absolute inset-0 mesh-grid mesh-pulse -z-10"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-base-100/50 to-base-100 -z-10"></div>

      <!-- Top bar -->
      <nav class="flex items-center justify-between px-6 py-6 max-w-7xl w-full mx-auto">
        <span class="font-display font-black text-xl tracking-wider text-white">
          BRILLIANTIER<span class="text-primary">.</span>
        </span>
        <span class="text-xs font-mono border border-primary/30 px-3 py-1 rounded-full bg-primary/5 text-primary tracking-widest uppercase">
          Phase 22 Active
        </span>
      </nav>

      <!-- Main hero content -->
      <div class="flex-1 flex flex-col items-center justify-center px-4 text-center max-w-4xl mx-auto w-full">
        <h1 class="font-display font-black text-5xl sm:text-7xl lg:text-8xl tracking-tight text-white mb-6 hero-animate">
          Brilliantier<span class="text-primary">.</span>
        </h1>
        <p class="text-lg sm:text-2xl text-gray-400 font-mono tracking-wide max-w-2xl mb-10 leading-relaxed hero-animate">
          Built from the block. Engineered for the world.
        </p>
        <div class="hero-animate">
          <a 
            href="#features" 
            class="group relative inline-flex items-center gap-2 px-8 py-4 bg-primary text-white font-display font-bold rounded-full overflow-hidden transition-all duration-300 hover:shadow-[0_0_30px_rgba(109,40,217,0.4)] active:scale-95"
          >
            <span class="absolute inset-0 bg-gradient-to-r from-secondary to-primary opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
            <span class="relative z-10">Enter the Mesh</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 relative z-10 transition-transform duration-300 group-hover:translate-x-1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Bottom status bar -->
      <div class="border-t border-white/5 bg-black/40 backdrop-blur-md py-4 px-6">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-gray-500 uppercase tracking-widest font-mono">
          <span>System Status: Fully Autonomous</span>
          <span>Core Inferences Running: Solar Green Aligned</span>
        </div>
      </div>
    </header>

    <!-- FEATURES SECTION -->
    <section id="features" class="py-24 relative overflow-hidden bg-base-100">
