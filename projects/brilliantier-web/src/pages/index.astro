    <!-- CONTACT SECTION -->
    <section class="py-32 bg-base-100 relative overflow-hidden">
      <!-- Ambient light -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-primary/10 rounded-full blur-[100px] -z-10"></div>
      
      <div class="max-w-4xl mx-auto text-center px-6">
        <h2 class="font-display font-black text-4xl sm:text-6xl text-white mb-6 tracking-tight">
          Work With The Sovereign
        </h2>
        <p class="text-gray-400 font-mono text-base sm:text-lg max-w-xl mx-auto mb-10 leading-relaxed">
          Initialize connection paths and coordinate node access. The mesh is open for engineering partnerships.
        </p>
        <a 
          href="mailto:alexander@brilliantier.com" 
          class="relative inline-flex items-center gap-2 px-8 py-4 bg-white text-black font-display font-bold rounded-full transition-all duration-300 hover:shadow-[0_0_30px_rgba(255,255,255,0.2)] active:scale-95 hover:bg-gray-100"
        >
          <span>Connect Node</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
