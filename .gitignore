# ============================================================================
# DENY-BY-DEFAULT BOUNDARY — this repository is rooted at $HOME.
#
# Rationale: see docs/reports/HOME_ROOT_REPOSITORY_RISK.md, which recommended
# this (Option C) and deferred it. Adopted 2026-07-31 after an audit found
# .claude.json (OAuth account + 6 MCP servers carrying env/headers),
# .codex/auth.json, .gemini/oauth_creds.json, .config/gh/hosts.yml,
# .config/gcloud and .zsh_history were all untracked-but-NOT-ignored in a
# repository whose remote is public.
#
# The previous model was allow-by-default with an explicit deny list. That can
# only ever protect against tools that already existed when the list was
# written — every new AI CLI or credential store dropped into $HOME landed
# inside the repo boundary by default. This inverts it: the root is ignored,
# and real project directories are re-allowed explicitly below.
#
# IMPORTANT: .gitignore never untracks already-tracked files. All 132
# currently-tracked top-level entries remain tracked and their modifications
# still appear in `git status`. This only governs what NEW files git picks up.
#
# To deliberately add a NEW file at the repository root:
#     git add -f <path>
# To add a NEW top-level project directory, give it an allow-line below.
# ============================================================================

/*

# --- Re-allowed project directories (the 25 with tracked content) ---
!/.agents/
!/bin/
!/brilliantaire-briefs/
!/config/
!/dashboard/
!/docs/
!/hooks/
!/Knowledge Core/
!/orchestrator/
!/outputs/
!/reports/
!/scratch/
!/scripts/
!/sentinel-os/
!/skills/
!/src/
!/staging/
!/templates/
!/test_inputs/
!/tools/
!/voice_input/
!/voice_queue/
!/voice_sessions/

# --- Partially-allowed directories ---
# macOS is case-insensitive, so tracked `projects/` and personal `Projects/`
# are the SAME directory: a blanket allow-line would re-admit 41 personal
# repo checkouts. Allow only the subdirectory that has tracked content.
!/projects/
/projects/*
!/projects/brilliantier-web/

# Documents/ holds 10 tracked files (Codex/.../voice_bridge/*) among ~500
# personal files. Those 10 stay tracked regardless — .gitignore never
# untracks — so ignoring the directory hides only NEW personal files, which
# is the desired behavior for a personal folder. To add one: git add -f
/Documents/

# --- Repository metadata that must stay visible ---
!/.gitignore
!/.env.example
!/CLAUDE.md
!/.claude/
!/requirements.txt

# ============================================================================
# Rules below apply WITHIN the re-allowed directories above.
# Ordering matters: these come after the re-allows so they still take effect.
# ============================================================================

node_modules/
dist/
.DS_Store
*.log
.env*
!.env.example
.env.local
.mcp.local.json
mcp_secrets/
scratch/
.skillopt-sleep/
runs/

# Audio and Piper Staging Cache
local_assets/
outputs/narrator/tts_queue/models/
outputs/narrator/tts_queue/rendered_audio/
outputs/narrator/tts_queue/bin/
*.wav
*.mp3
*.tar.gz
test.wav
.zsh_secrets

# Next.js build output
sentinel-os/.next/

# Quarantine storage
.quarantine/

# Python environment and caches
__pycache__/
venv_stable/
*.pyc
.pytest_cache/

# Linter caches
.eslintcache

# Local backup files
*.bak
*.tmp

# Verification output logs
verify-output.txt
verify-governance-output.txt

# ICYFLAMZE CORE Episode 1 — render intake generated artifacts.
# Regenerated in full on every `icyflamze-core-episode-1-render-intake` run,
# one timestamped set per invocation. checklists/ is deliberately NOT listed:
# visual-continuity and audio reviews are annotated by hand.
outputs/icyflamze_core/episode_1/render_intake/logs/
outputs/icyflamze_core/episode_1/render_intake/reports/

# ============================================================================
# Defense in depth. Every path below is already covered by the `/*` boundary
# above; they are retained deliberately so that if a future allow-line ever
# widens the boundary, these still never become trackable.
# Original containment pass 2026-07-20: docs/reports/GITIGNORE_SECURITY_BASELINE.md
# ============================================================================

# Credentials — must never be tracked
.ssh/
.aws/
.gnupg/
.kube/
.docker/
.git-credentials
.netrc
.npmrc
.pypirc

# Agent-CLI credential stores (2026-07-31 audit findings)
.claude.json
.claude.json.*
.codex/
.gemini/
.antigravity.json
.antigravityrules
.config/
.cursor/
.hermes/

# Shell history and git identity — routinely contain pasted secrets
.zsh_history
.bash_history
.gitconfig

# OS and user-local data
Library/
Applications/
Desktop/
Downloads/
Movies/
Music/
Pictures/
Public/

# Common local caches and tooling
.cache/
.npm/
.pnpm-store/
.yarn/
.local/
.vscode/
.idea/
