# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...

# Set to "off" to disable the subscription paywall (e.g. before running migration 19)
# BILLING_ENFORCEMENT=off

# Shared rate-limit counters (Upstash Redis, REST). Without these the limits
# are per server instance only, which is fine for one instance.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
# Optional key prefix if one database serves more than one app (default: rl)
# RATE_LIMIT_PREFIX=icyos

# Personal access tokens (P.J.K.): Supabase → Settings → API → JWT settings.
SUPABASE_JWT_SECRET=your-jwt-secret

# Legal pages (see LEGAL.md).
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=your-legal-contact@example.com
NEXT_PUBLIC_HOSTING_PROVIDER=Vercel

# Optional: Claude sorts Inbox brain dumps. Without it, simple rules do.
# ANTHROPIC_API_KEY=
